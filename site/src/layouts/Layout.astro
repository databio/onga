---
import '../styles/global.css';
import { url } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  side?: 'browse' | 'develop';
}

const { title, description = 'ONGA - Ontology for Genomic Annotations', side = 'browse' } = Astro.props;
const currentPath = Astro.url.pathname;

// Grouped browse navigation, rendered as hover dropdowns to avoid overflow.
const navGroups = [
  {
    label: 'Vocabularies',
    color: { active: 'text-blue-700', item: 'text-blue-600', hover: 'hover:bg-blue-50 hover:text-blue-800' },
    items: [
      { href: '/data-types', label: 'DataTypes' },
      { href: '/feature-types', label: 'FeatureTypes' },
      { href: '/formats', label: 'Formats' },
    ],
  },
  {
    label: 'Facets',
    color: { active: 'text-indigo-700', item: 'text-indigo-500', hover: 'hover:bg-indigo-50 hover:text-indigo-800' },
    items: [
      { href: '/strand-orientation', label: 'Strand' },
      { href: '/read-multiplicity', label: 'ReadMultiplicity' },
      { href: '/filter-status', label: 'FilterStatus' },
      { href: '/normalization', label: 'Normalization' },
      { href: '/thresholding', label: 'Thresholding' },
      { href: '/derivation', label: 'Derivation' },
      { href: '/reference-build-sex', label: 'BuildSex' },
      { href: '/haplotype-resolution', label: 'HaplotypeResolution' },
    ],
  },
  {
    label: 'Schemas',
    color: { active: 'text-amber-700', item: 'text-amber-600', hover: 'hover:bg-amber-50 hover:text-amber-800' },
    items: [
      { href: '/track-format', label: 'Track Format' },
      { href: '/track-interpretation', label: 'Interpretation' },
      { href: '/track-provenance', label: 'Provenance' },
      { href: '/track-geometry', label: 'Geometry' },
      { href: '/reference-genome', label: 'Reference Genome' },
    ],
  },
];

const isActive = (p: string) => currentPath.startsWith(url(p));
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | ONGA</title>
    <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900">
    <header class="bg-white border-b border-gray-200">
      <div class="max-w-6xl mx-auto px-4 py-4">
        <nav class="flex items-center justify-between">
          <div class="flex items-center gap-6">
            <a href={url("/")} class="text-xl font-bold text-blue-700 hover:text-blue-900">
              ONGA
            </a>
            <div class="flex bg-gray-100 rounded-lg p-0.5 text-sm">
              <a
                href={url("/")}
                class:list={[
                  'px-3 py-1.5 rounded-md font-medium transition-colors',
                  side === 'browse' ? 'bg-white text-gray-900 shadow-sm' : 'text-gray-500 hover:text-gray-700'
                ]}
              >
                Browse
              </a>
              <a
                href={url("/develop")}
                class:list={[
                  'px-3 py-1.5 rounded-md font-medium transition-colors',
                  side === 'develop' ? 'bg-white text-gray-900 shadow-sm' : 'text-gray-500 hover:text-gray-700'
                ]}
              >
                Develop
              </a>
            </div>
          </div>
          <div class="flex items-center gap-4 text-sm">
            {side === 'browse' ? (
              <>
                <a href={url("/")} class:list={['hover:text-gray-900', currentPath === url('/') ? 'text-gray-900 font-medium' : 'text-gray-600']}>Home</a>
                {navGroups.map((group) => {
                  const groupActive = group.items.some((i) => isActive(i.href));
                  return (
                    <div class="relative group">
                      <button
                        type="button"
                        class:list={[
                          'flex items-center gap-1 hover:text-gray-900',
                          groupActive ? `${group.color.active} font-medium` : 'text-gray-600',
                        ]}
                      >
                        {group.label}
                        <svg class="w-3 h-3 text-gray-400 transition-transform group-hover:rotate-180" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5">
                          <path d="M3 4.5L6 7.5L9 4.5" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </button>
                      <div class="absolute right-0 top-full pt-2 hidden group-hover:block z-50">
                        <div class="bg-white border border-gray-200 rounded-lg shadow-lg py-1 min-w-[12rem]">
                          {group.items.map((item) => (
                            <a
                              href={url(item.href)}
                              class:list={[
                                'block px-4 py-2 whitespace-nowrap',
                                group.color.hover,
                                isActive(item.href) ? `${group.color.active} font-medium` : group.color.item,
                              ]}
                            >
                              {item.label}
                            </a>
                          ))}
                        </div>
                      </div>
                    </div>
                  );
                })}
                <span class="text-gray-300">|</span>
                <a href={url("/scope")} class:list={['hover:text-rose-800', currentPath.startsWith(url('/scope')) ? 'text-rose-700 font-medium' : 'text-rose-600']}>Scope</a>
                <a href={url("/mappings")} class:list={['hover:text-gray-900', currentPath.startsWith(url('/mappings')) ? 'text-gray-900 font-medium' : 'text-gray-600']}>Mappings</a>
                <a href={url("/about")} class:list={['hover:text-gray-900', currentPath.startsWith(url('/about')) ? 'text-gray-900 font-medium' : 'text-gray-600']}>About</a>
              </>
            ) : (
              <>
                <a href={url("/develop")} class:list={['hover:text-gray-900', currentPath === url('/develop') || currentPath === url('/develop/') ? 'text-gray-900 font-medium' : 'text-gray-600']}>Overview</a>
                <a href={url("/develop/merge-candidates")} class:list={['hover:text-gray-900', currentPath.startsWith(url('/develop/merge-candidates')) ? 'text-gray-900 font-medium' : 'text-gray-600']}>Merge Candidates</a>
                <a href={url("/develop/gaps")} class:list={['hover:text-gray-900', currentPath.startsWith(url('/develop/gaps')) ? 'text-gray-900 font-medium' : 'text-gray-600']}>Gaps</a>
                <a href={url("/develop/mapping-suggestions")} class:list={['hover:text-gray-900', currentPath.startsWith(url('/develop/mapping-suggestions')) ? 'text-gray-900 font-medium' : 'text-gray-600']}>Mapping Suggestions</a>
                <a href={url("/develop/quality-issues")} class:list={['hover:text-gray-900', currentPath.startsWith(url('/develop/quality-issues')) ? 'text-gray-900 font-medium' : 'text-gray-600']}>Quality Issues</a>
                <a href={url("/develop/frequency")} class:list={['hover:text-gray-900', currentPath.startsWith(url('/develop/frequency')) ? 'text-gray-900 font-medium' : 'text-gray-600']}>Usage Frequency</a>
                <a href={url("/develop/changeset")} class:list={['hover:text-gray-900', currentPath.startsWith(url('/develop/changeset')) ? 'text-gray-900 font-medium' : 'text-gray-600']}>Changeset</a>
              </>
            )}
          </div>
        </nav>
      </div>
    </header>
    <main class="max-w-6xl mx-auto px-4 py-8">
      <slot />
    </main>
    <footer class="border-t border-gray-200 mt-16">
      <div class="max-w-6xl mx-auto px-4 py-8 text-center text-sm text-gray-500">
        <p>ONGA is licensed under <a href="https://creativecommons.org/licenses/by/4.0/" class="underline hover:text-gray-700">CC BY 4.0</a></p>
        <p class="mt-1">
          Derived from <a href="https://www.encodeproject.org/" class="underline hover:text-gray-700">ENCODE</a> output_type vocabulary
        </p>
      </div>
    </footer>
  </body>
</html>
