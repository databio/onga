---
import { url } from '../../lib/url';
import Layout from '../../layouts/Layout.astro';
import terms from '../../data/normalization.json';
---

<Layout title="Normalization" description="Facet vocabulary of scaling normalization — factored out of compound DataType terms">
  <div class="mb-8">
    <p class="text-[11px] uppercase tracking-wide text-indigo-400 font-semibold">Facet vocabulary</p>
    <h1 class="text-3xl font-bold text-gray-900 mb-2">Normalization</h1>
    <p class="text-indigo-600 font-medium">{terms.length} terms</p>
    <p class="text-gray-600 mt-2">
      Controlled vocabulary distinguishing the scaling normalization applied to a
      signal (raw vs depth-normalized vs percentage-normalized). A small
      <strong>facet</strong> vocabulary that factors the scaling qualifier out of
      compound ENCODE
      <code class="bg-gray-100 px-1 rounded">output_type</code> / DataType terms
      (e.g. "raw signal", "normalized signal", "percentage normalized signal").
      A <strong>provenance</strong> facet: it records the scaling operation
      applied to produce the values, not what the values mean. An absent value
      means unspecified — <em>not</em> raw (the generic
      <code class="bg-gray-100 px-1 rounded">signal</code> term carries no
      normalization value). This axis covers only scaling; it does
      <strong>not</strong> cover statistic transforms (p-value, fold-change,
      z-score, enrichment) or smoothing, which change what the values mean and
      remain distinct output_types. Surfaced via the
      <a href={url("/track-provenance")} class="text-amber-600 underline hover:text-amber-800">Track Provenance</a>
      schema's <code class="bg-gray-100 px-1 rounded">normalization</code> slot.
      Aligned with FGA-WG issue #2 (data interpretation).
    </p>
  </div>

  <!-- Terms -->
  <div class="bg-white rounded-lg shadow-sm divide-y divide-gray-100">
    {terms.map((term: any) => (
      <div class="block p-4">
        <div class="flex items-start justify-between">
          <div>
            <h3 class="font-medium text-gray-900 font-mono text-sm">{term.name}</h3>
            <p class="text-sm text-gray-500 mt-1">{term.description}</p>
          </div>
          {term.edamMapping && (
            <span class="text-xs bg-indigo-100 text-indigo-800 px-2 py-1 rounded shrink-0 ml-4 font-mono">
              {term.edamMapping.edamId}
            </span>
          )}
        </div>
      </div>
    ))}
  </div>
</Layout>
