---
import { url } from '../../lib/url';
import Layout from '../../layouts/Layout.astro';
import terms from '../../data/derivation.json';
---

<Layout title="Derivation" description="Facet vocabulary of epistemic origin — observed vs. predicted — factored out of compound DataType terms">
  <div class="mb-8">
    <p class="text-[11px] uppercase tracking-wide text-indigo-400 font-semibold">Facet vocabulary</p>
    <h1 class="text-3xl font-bold text-gray-900 mb-2">Derivation</h1>
    <p class="text-indigo-600 font-medium">{terms.length} terms</p>
    <p class="text-gray-600 mt-2">
      Controlled vocabulary recording the <strong>epistemic origin</strong> of a
      file's values: whether they were empirically <em>observed</em> (measured from
      experimental sequencing data) or computationally <em>predicted</em> (generated
      by a statistical/computational model rather than directly measured). A small
      <strong>facet</strong> vocabulary that factors the measured-vs-model qualifier
      out of compound ENCODE
      <code class="bg-gray-100 px-1 rounded">output_type</code> / DataType /
      FeatureType terms (e.g. "observed signal profile", "predicted signal profile",
      "predicted transcription start sites"). A <strong>provenance</strong> facet: it
      records how the values were obtained, not what they mean. An absent value means
      the derivation is unspecified (<em>not</em> a default of observed). The vocabulary
      is deliberately two-valued; <code class="bg-gray-100 px-1 rounded">control</code>
      is excluded because it denotes an experimental role or a normalization reference,
      not the measured-vs-model axis. Surfaced via the
      <a href={url("/track-provenance")} class="text-amber-600 underline hover:text-amber-800">Track Provenance</a>
      schema's <code class="bg-gray-100 px-1 rounded">derivation</code> slot.
      Aligned with FGA-WG issue #2 (data interpretation).
    </p>
  </div>

  <!-- Terms -->
  <div class="bg-white rounded-lg shadow-sm divide-y divide-gray-100">
    {terms.map((term: any) => (
      <div class="block p-4">
        <div class="flex items-start justify-between">
          <div>
            <h3 class="font-medium text-gray-900 font-mono text-sm">{term.name}</h3>
            <p class="text-sm text-gray-500 mt-1">{term.description}</p>
          </div>
          {term.edamMapping && (
            <span class="text-xs bg-indigo-100 text-indigo-800 px-2 py-1 rounded shrink-0 ml-4 font-mono">
              {term.edamMapping.edamId}
            </span>
          )}
        </div>
      </div>
    ))}
  </div>
</Layout>
