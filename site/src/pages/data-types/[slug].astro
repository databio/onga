---
import { url } from '../../lib/url';
import Layout from '../../layouts/Layout.astro';
import dataTypes from '../../data/data-types.json';
import featureTypes from '../../data/feature-types.json';
import dataTypesByCategory from '../../data/data-types-by-category.json';

export function getStaticPaths() {
  return (dataTypes as any[]).map((term) => ({
    params: { slug: term.slug },
    props: { term }
  }));
}

const { term } = Astro.props;
const relatedTerms = ((dataTypesByCategory as any)[term.category] || [])
  .filter((t: any) => t.slug !== term.slug)
  .slice(0, 8);

// Find linked FeatureTypes
const linkedFeatures = (term.seeAlso || []).map((name: string) => {
  const found = (featureTypes as any[]).find(f =>
    f.name.toLowerCase() === name.toLowerCase() ||
    f.slug === name.toLowerCase().replace(/[^a-z0-9]+/g, '_')
  );
  return found || { name, slug: null };
});

function edamUrl(edamId: string): string {
  const id = edamId.replace('edam:', '');
  return `http://edamontology.org/${id}`;
}
---

<Layout title={term.name} description={term.description}>
  <nav class="text-sm text-gray-500 mb-6">
    <a href={url("/")} class="hover:text-gray-700">Home</a>
    <span class="mx-2">/</span>
    <a href={url("/data-types")} class="hover:text-gray-700">DataTypes</a>
    <span class="mx-2">/</span>
    <span class="text-gray-900">{term.name}</span>
  </nav>

  <article class="bg-white rounded-lg shadow-sm">
    <header class="p-6 border-b border-gray-100">
      <div class="flex items-center gap-3 mb-2">
        <span class="text-xs bg-blue-100 text-blue-800 px-2 py-1 rounded font-medium">DataType</span>
        <span class="text-xs bg-gray-100 text-gray-600 px-2 py-1 rounded">{term.category}</span>
      </div>
      <h1 class="text-3xl font-bold text-gray-900 mb-2">{term.name}</h1>
      <code class="text-sm text-gray-500 bg-gray-100 px-2 py-1 rounded">onga:{term.id}</code>
    </header>

    <div class="p-6 space-y-6">
      <section>
        <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-2">Definition</h2>
        <p class="text-gray-700">{term.description || 'No definition available.'}</p>
      </section>

      {linkedFeatures.length > 0 && (
        <section>
          <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-2">
            Can represent (FeatureTypes)
          </h2>
          <p class="text-xs text-gray-500 mb-3">Biological features this data type might capture</p>
          <div class="flex flex-wrap gap-2">
            {linkedFeatures.map((f: any) => (
              f.slug ? (
                <a href={url(`/feature-types/${f.slug}`)} class="text-sm bg-green-100 text-green-800 px-3 py-1 rounded-full hover:bg-green-200">
                  {f.name}
                </a>
              ) : (
                <span class="text-sm bg-gray-100 text-gray-600 px-3 py-1 rounded-full">{f.name}</span>
              )
            ))}
          </div>
        </section>
      )}

      {term.edamMapping && (
        <section>
          <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-2">EDAM Mapping</h2>
          <div class="bg-blue-50 rounded-lg p-4">
            <span class="text-xs font-medium bg-blue-200 text-blue-800 px-2 py-1 rounded mr-2">
              {term.edamMapping.predicate}
            </span>
            <a href={edamUrl(term.edamMapping.edamId)} target="_blank" rel="noopener" class="text-blue-800 hover:underline">
              {term.edamMapping.edamId}
            </a>
            {term.edamMapping.edamLabel && (
              <p class="text-sm text-blue-700 mt-2">{term.edamMapping.edamLabel}</p>
            )}
          </div>
        </section>
      )}

      {term.elementType && (
        <section>
          <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-2">Element type</h2>
          <p class="text-xs text-gray-500 mb-3">
            This term names a <strong>set</strong>. Its individual rows are instances of the
            Sequence Ontology class{term.elementType.classes.length > 1 ? 'es' : ''} below
            (<code class="bg-gray-100 px-1 rounded">onga:has_element_type</code>).
          </p>
          <div class="bg-teal-50 rounded-lg p-4">
            <span class="text-xs font-medium bg-teal-200 text-teal-900 px-2 py-1 rounded mr-2">
              fit: {term.elementType.fit}
            </span>
            {term.elementType.classes.length > 1 && (
              <span class="text-xs text-teal-800">mixed set — rows may be instances of any of these</span>
            )}
            <ul class="mt-3 space-y-1">
              {term.elementType.classes.map((c: any) => (
                <li>
                  <a href={c.url} target="_blank" rel="noopener" class="font-mono text-teal-800 hover:underline">{c.id}</a>
                  {c.label && <span class="text-sm text-teal-700 ml-2">{c.label}</span>}
                </li>
              ))}
            </ul>
          </div>
        </section>
      )}

      {!term.elementType && term.elementTypeFit === 'not_applicable' && (
        <section>
          <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-2">Element type</h2>
          <div class="bg-gray-50 rounded-lg p-4 text-sm text-gray-600">
            <span class="text-xs font-medium bg-gray-200 text-gray-700 px-2 py-1 rounded mr-2">not applicable</span>
            Reviewed: the rows of this term are not Sequence Ontology features (they are
            values, matrices, models or edges), so it carries no element type.
          </div>
        </section>
      )}

      {(term.soMapping || []).filter((m: any) => m.predicate !== 'onga:has_element_type').length > 0 && (
        <section>
          <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-2">Related SO classes</h2>
          <div class="bg-gray-50 rounded-lg p-4 space-y-2">
            {term.soMapping.filter((m: any) => m.predicate !== 'onga:has_element_type').map((m: any) => (
              <div>
                <span class="text-xs font-medium bg-gray-200 text-gray-700 px-2 py-1 rounded mr-2 font-mono">{m.predicateShort}</span>
                <a href={m.soUrl} target="_blank" rel="noopener" class="font-mono text-gray-800 hover:underline">{m.soId}</a>
                {m.soLabel && <span class="text-sm text-gray-600 ml-2">{m.soLabel}</span>}
                {m.comment && <p class="text-xs text-gray-500 mt-1">{m.comment}</p>}
              </div>
            ))}
          </div>
        </section>
      )}

      {relatedTerms.length > 0 && (
        <section>
          <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-2">Related DataTypes</h2>
          <div class="flex flex-wrap gap-2">
            {relatedTerms.map((t: any) => (
              <a href={url(`/data-types/${t.slug}`)} class="text-sm bg-gray-100 text-gray-700 px-3 py-1 rounded-full hover:bg-gray-200">
                {t.name}
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </article>
</Layout>
