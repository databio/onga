---
import { url } from '../../../lib/url';
import Layout from '../../../layouts/Layout.astro';
import enums from '../../../data/schema/enums.json';
import StateChip from '../../../components/StateChip.astro';
import ReviewLink from '../../../components/ReviewLink.astro';
import { enumValue } from '../../../lib/browse';

// Generic enum detail page for the structural enums (ValueType,
// AccessProtocol, BiospecimenClassification, ...). The hand-curated Layer-1
// vocabularies keep their own richer pages and never route here.
export function getStaticPaths() {
  return enums.map((en: any) => ({ params: { name: en.name }, props: { en } }));
}

const { en } = Astro.props;
const linkify = (v: string) => (String(v).startsWith('http') ? v : null);
---

<Layout title={en.name} description={en.description}>
  <nav class="text-sm text-gray-500 mb-4">
    <a href={url('/schema')} class="hover:text-gray-700">Schema Browser</a>
    <span class="mx-1">/</span>
    <a href={url('/schema#enums')} class="hover:text-gray-700">Structural enums</a>
    <span class="mx-1">/</span>
    <span class="text-gray-900 font-medium">{en.name}</span>
  </nav>

  <div class="mb-8">
    <div class="flex items-center gap-3 flex-wrap">
      <h1 class="text-3xl font-bold font-mono text-gray-900">{en.name}</h1>
      <span class="text-xs px-2 py-1 rounded font-medium bg-indigo-100 text-indigo-800">enum · {en.values.length} values</span>
      <ReviewLink sid={`enum:${en.name}`} />
    </div>
    <p class="text-gray-600 mt-3 max-w-3xl">{en.description}</p>
    {en.source && (
      <p class="text-sm text-gray-500 mt-2">
        Source:{' '}
        {linkify(en.source)
          ? <a href={en.source} class="font-mono text-xs text-blue-600 underline hover:text-blue-800">{en.source}</a>
          : <span class="font-mono text-xs">{en.source}</span>}
      </p>
    )}
  </div>

  <section class="mb-8">
    <div class="bg-white rounded-lg shadow-sm overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-left text-xs text-gray-500 uppercase tracking-wide border-b border-gray-200">
            <th class="px-4 py-3">Value</th>
            <th class="px-4 py-3">Id</th>
            <th class="px-4 py-3">Description</th>
          </tr>
        </thead>
        <tbody>
          {en.values.map((v: any) => {
            const t = enumValue(en.name, v.name);
            return (
              <tr class="border-b border-gray-100 align-top">
                <td class="px-4 py-3 font-mono whitespace-nowrap">{v.name}</td>
                <td class="px-4 py-3 font-mono text-xs text-gray-500 whitespace-nowrap">
                  {t ? t.name : '—'}
                  {t && <div class="mt-1"><StateChip sid={t.sid} link /></div>}
                </td>
                <td class="px-4 py-3 text-gray-600">{v.description}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>

  {en.referencedBy.length > 0 && (
    <section class="mb-8">
      <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-2">Used by</h2>
      <div class="flex flex-wrap gap-2">
        {en.referencedBy.map((r: any) => (
          <a href={url(r.href)} class="font-mono text-sm bg-white shadow-sm rounded px-3 py-1.5 text-blue-600 underline hover:text-blue-800">{r.name}</a>
        ))}
      </div>
    </section>
  )}
</Layout>
