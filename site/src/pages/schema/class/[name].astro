---
import { url } from '../../../lib/url';
import Layout from '../../../layouts/Layout.astro';
import classes from '../../../data/schema/classes.json';

// Generic class detail page: slot table, is_a up-link, referenced_by
// back-links, and a provenance box for the lineage / external-standard
// annotations. Driven entirely by the generated schema JSON.
export function getStaticPaths() {
  return classes.map((cls: any) => ({ params: { name: cls.name }, props: { cls } }));
}

const { cls } = Astro.props;
const layerColors: Record<number, string> = {
  2: 'bg-amber-100 text-amber-800',
  3: 'bg-emerald-100 text-emerald-800',
  4: 'bg-purple-100 text-purple-800',
};
const hasProvenance = cls.conformsTo || cls.source || cls.seeAlso.length ||
  cls.closeMappings.length || cls.exactMappings.length;
const linkify = (v: string) => (String(v).startsWith('http') ? v : null);
---

<Layout title={cls.name} description={cls.description}>
  <nav class="text-sm text-gray-500 mb-4">
    <a href={url('/schema')} class="hover:text-gray-700">Schema Browser</a>
    <span class="mx-1">/</span>
    <a href={url(`/schema#${cls.layer === 2 ? 'descriptor' : cls.layer === 3 ? 'record' : 'investigation'}`)} class="hover:text-gray-700">{cls.layerName}</a>
    <span class="mx-1">/</span>
    <span class="text-gray-900 font-medium">{cls.name}</span>
  </nav>

  <div class="mb-8">
    <div class="flex items-center gap-3 flex-wrap">
      <h1 class="text-3xl font-bold font-mono text-gray-900">{cls.name}</h1>
      <span class:list={['text-xs px-2 py-1 rounded font-medium', layerColors[cls.layer] || 'bg-gray-100 text-gray-800']}>
        Layer {cls.layer} · {cls.layerName}
      </span>
      {cls.isA && (
        <span class="text-sm text-gray-500">
          is_a <a href={url(cls.isAHref)} class="font-mono text-blue-600 underline hover:text-blue-800">{cls.isA}</a>
        </span>
      )}
    </div>
    <p class="text-gray-600 mt-3 max-w-3xl">{cls.description}</p>
  </div>

  {hasProvenance && (
    <section class="bg-gray-50 border border-gray-200 rounded-lg p-4 mb-8 text-sm">
      <h2 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Provenance &amp; alignment</h2>
      <dl class="space-y-1">
        {cls.conformsTo && (
          <div><dt class="inline text-gray-500">Conforms to:</dt> <dd class="inline font-medium">{cls.conformsTo}</dd></div>
        )}
        {cls.source && (
          <div>
            <dt class="inline text-gray-500">Source:</dt>{' '}
            <dd class="inline font-mono text-xs">
              {linkify(cls.source)
                ? <a href={cls.source} class="text-blue-600 underline hover:text-blue-800">{cls.source}</a>
                : cls.source}
            </dd>
          </div>
        )}
        {cls.exactMappings.length > 0 && (
          <div><dt class="inline text-gray-500">Exact mappings:</dt> <dd class="inline font-mono text-xs">{cls.exactMappings.join(', ')}</dd></div>
        )}
        {cls.closeMappings.length > 0 && (
          <div><dt class="inline text-gray-500">Close mappings:</dt> <dd class="inline font-mono text-xs">{cls.closeMappings.join(', ')}</dd></div>
        )}
        {cls.seeAlso.length > 0 && (
          <div>
            <dt class="inline text-gray-500">See also:</dt>{' '}
            <dd class="inline font-mono text-xs">
              {cls.seeAlso.map((s: string, i: number) => (
                <>
                  {i > 0 && ', '}
                  {linkify(s)
                    ? <a href={s} class="text-blue-600 underline hover:text-blue-800">{s}</a>
                    : s}
                </>
              ))}
            </dd>
          </div>
        )}
      </dl>
    </section>
  )}

  <section class="mb-8">
    <h2 class="text-xl font-bold text-gray-900 mb-3">Slots</h2>
    <div class="bg-white rounded-lg shadow-sm overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-left text-xs text-gray-500 uppercase tracking-wide border-b border-gray-200">
            <th class="px-4 py-3">Slot</th>
            <th class="px-4 py-3">Range</th>
            <th class="px-4 py-3">Card.</th>
            <th class="px-4 py-3">Description</th>
          </tr>
        </thead>
        <tbody>
          {cls.slots.map((slot: any) => (
            <tr class="border-b border-gray-100 align-top">
              <td class="px-4 py-3 font-mono whitespace-nowrap">
                {slot.name}
                <div class="flex gap-1 mt-1 flex-wrap">
                  {slot.identifier && <span class="text-[10px] bg-gray-800 text-white px-1.5 py-0.5 rounded">identifier</span>}
                  {slot.required && <span class="text-[10px] bg-red-100 text-red-800 px-1.5 py-0.5 rounded">required</span>}
                  {slot.recommended && <span class="text-[10px] bg-yellow-100 text-yellow-800 px-1.5 py-0.5 rounded">recommended</span>}
                  {slot.inheritedFrom && <span class="text-[10px] bg-blue-50 text-blue-700 px-1.5 py-0.5 rounded">from {slot.inheritedFrom}</span>}
                </div>
              </td>
              <td class="px-4 py-3 whitespace-nowrap">
                {slot.rangeHref
                  ? <a href={url(slot.rangeHref)} class:list={['font-mono underline', slot.rangeKind === 'class' ? 'text-emerald-700 hover:text-emerald-900' : 'text-indigo-600 hover:text-indigo-800']}>{slot.range}</a>
                  : <span class="font-mono text-gray-500">{slot.range}</span>}
              </td>
              <td class="px-4 py-3 text-gray-500 whitespace-nowrap">{slot.multivalued ? 'many' : 'one'}</td>
              <td class="px-4 py-3 text-gray-600">{slot.description}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  {cls.rules.length > 0 && (
    <section class="mb-8">
      <h2 class="text-xl font-bold text-gray-900 mb-3">Conditional rules</h2>
      <ul class="bg-white rounded-lg shadow-sm p-4 space-y-2 text-sm text-gray-600 list-disc list-inside">
        {cls.rules.map((r: any) => <li>{r.summary}</li>)}
      </ul>
    </section>
  )}

  {cls.referencedBy.length > 0 && (
    <section class="mb-8">
      <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-2">Referenced by</h2>
      <div class="flex flex-wrap gap-2">
        {cls.referencedBy.map((r: any) => (
          <a href={url(r.href)} class="font-mono text-sm bg-white shadow-sm rounded px-3 py-1.5 text-blue-600 underline hover:text-blue-800">{r.name}</a>
        ))}
      </div>
    </section>
  )}
</Layout>
