---
import Layout from '../../layouts/Layout.astro';
import terms from '../../data/reference-build-sex.json';
---

<Layout title="Reference Build Sex" description="Facet vocabulary of reference-assembly sex — factored out of compound DataType terms">
  <div class="mb-8">
    <p class="text-[11px] uppercase tracking-wide text-indigo-400 font-semibold">Facet vocabulary</p>
    <h1 class="text-3xl font-bold text-gray-900 mb-2">ReferenceBuildSex</h1>
    <p class="text-indigo-600 font-medium">{terms.length} terms</p>
    <p class="text-gray-600 mt-2">
      Controlled vocabulary recording the sex of the reference genome
      <strong>build</strong> a track is defined against — i.e. which sex chromosomes
      the reference assembly contains (a male assembly carries X and Y; a female
      assembly carries X only). A small <strong>facet</strong> vocabulary that factors
      the male/female qualifier out of compound ENCODE
      <code class="bg-gray-100 px-1 rounded">output_type</code> / DataType terms
      (e.g. "male genome reference", "female genome index"). An absent value means the
      build sex is unspecified — a sex-neutral / combined assembly. Surfaced via the
      <a href="/reference-genome" class="text-amber-600 underline hover:text-amber-800">Reference Genome</a>
      schema's <code class="bg-gray-100 px-1 rounded">build_sex</code> slot.
    </p>
    <p class="text-sm text-amber-700 bg-amber-50 border border-amber-200 rounded p-3 mt-4 max-w-2xl">
      <strong>Important:</strong> this records the sex of the reference genome
      <em>build</em>, NOT the biological sample's sex. Sample sex is a biospecimen
      property and is <a href="/scope" class="underline hover:text-amber-900">delegated to PATO</a>
      (FAIRtracks has no sex field, so it cannot be imported from the FGA-WG).
    </p>
  </div>

  <!-- Terms -->
  <div class="bg-white rounded-lg shadow-sm divide-y divide-gray-100">
    {terms.map((term: any) => (
      <div class="block p-4">
        <div class="flex items-start justify-between">
          <div>
            <h3 class="font-medium text-gray-900 font-mono text-sm">{term.name}</h3>
            <p class="text-sm text-gray-500 mt-1">{term.description}</p>
          </div>
          {term.edamMapping && (
            <span class="text-xs bg-indigo-100 text-indigo-800 px-2 py-1 rounded shrink-0 ml-4 font-mono">
              {term.edamMapping.edamId}
            </span>
          )}
        </div>
      </div>
    ))}
  </div>
</Layout>
