---
import Layout from '../../layouts/Layout.astro';
import terms from '../../data/read-multiplicity.json';
---

<Layout title="Read Multiplicity" description="Facet vocabulary of read mapping-multiplicity — factored out of compound DataType terms">
  <div class="mb-8">
    <p class="text-[11px] uppercase tracking-wide text-indigo-400 font-semibold">Facet vocabulary</p>
    <h1 class="text-3xl font-bold text-gray-900 mb-2">ReadMultiplicity</h1>
    <p class="text-indigo-600 font-medium">{terms.length} terms</p>
    <p class="text-gray-600 mt-2">
      Controlled vocabulary distinguishing the read mapping-multiplicity subset
      used to compute a signal or count track (all mapped reads vs
      uniquely-mapping reads only). A small <strong>facet</strong> vocabulary that
      factors the mapping-multiplicity qualifier out of compound ENCODE
      <code class="bg-gray-100 px-1 rounded">output_type</code> / DataType terms
      (e.g. "signal of all reads"). Surfaced via the
      <a href="/track-interpretation" class="text-amber-600 underline hover:text-amber-800">Track Interpretation</a>
      schema's <code class="bg-gray-100 px-1 rounded">read_multiplicity</code> slot.
      Aligned with FGA-WG issue #2 (data interpretation).
    </p>
  </div>

  <!-- Terms -->
  <div class="bg-white rounded-lg shadow-sm divide-y divide-gray-100">
    {terms.map((term: any) => (
      <div class="block p-4">
        <div class="flex items-start justify-between">
          <div>
            <h3 class="font-medium text-gray-900 font-mono text-sm">{term.name}</h3>
            <p class="text-sm text-gray-500 mt-1">{term.description}</p>
          </div>
          {term.edamMapping && (
            <span class="text-xs bg-indigo-100 text-indigo-800 px-2 py-1 rounded shrink-0 ml-4 font-mono">
              {term.edamMapping.edamId}
            </span>
          )}
        </div>
      </div>
    ))}
  </div>
</Layout>
