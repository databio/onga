---
import Layout from '../../layouts/Layout.astro';
import featureTypes from '../../data/feature-types.json';
import dataTypes from '../../data/data-types.json';
import featureTypesByCategory from '../../data/feature-types-by-category.json';

export function getStaticPaths() {
  return (featureTypes as any[]).map((term) => ({
    params: { slug: term.slug },
    props: { term }
  }));
}

const { term } = Astro.props;
const relatedTerms = ((featureTypesByCategory as any)[term.category] || [])
  .filter((t: any) => t.slug !== term.slug)
  .slice(0, 8);

// Find linked DataTypes
const linkedDataTypes = (term.seeAlso || []).map((name: string) => {
  const found = (dataTypes as any[]).find(d =>
    d.name.toLowerCase() === name.toLowerCase() ||
    d.slug === name.toLowerCase().replace(/[^a-z0-9]+/g, '_')
  );
  return found || { name, slug: null };
});

function edamUrl(edamId: string): string {
  const id = edamId.replace('edam:', '');
  return `http://edamontology.org/${id}`;
}
---

<Layout title={term.name} description={term.description}>
  <nav class="text-sm text-gray-500 mb-6">
    <a href="/" class="hover:text-gray-700">Home</a>
    <span class="mx-2">/</span>
    <a href="/feature-types" class="hover:text-gray-700">FeatureTypes</a>
    <span class="mx-2">/</span>
    <span class="text-gray-900">{term.name}</span>
  </nav>

  <article class="bg-white rounded-lg shadow-sm">
    <header class="p-6 border-b border-gray-100">
      <div class="flex items-center gap-3 mb-2">
        <span class="text-xs bg-green-100 text-green-800 px-2 py-1 rounded font-medium">FeatureType</span>
        <span class="text-xs bg-gray-100 text-gray-600 px-2 py-1 rounded">{term.category}</span>
      </div>
      <h1 class="text-3xl font-bold text-gray-900 mb-2">{term.name}</h1>
      <code class="text-sm text-gray-500 bg-gray-100 px-2 py-1 rounded">onga:{term.id}</code>
    </header>

    <div class="p-6 space-y-6">
      <section>
        <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-2">Definition</h2>
        <p class="text-gray-700">{term.description || 'No definition available.'}</p>
      </section>

      {linkedDataTypes.length > 0 && (
        <section>
          <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-2">
            Produced by (DataTypes)
          </h2>
          <p class="text-xs text-gray-500 mb-3">Data types that can capture this biological feature</p>
          <div class="flex flex-wrap gap-2">
            {linkedDataTypes.map((d: any) => (
              d.slug ? (
                <a href={`/data-types/${d.slug}`} class="text-sm bg-blue-100 text-blue-800 px-3 py-1 rounded-full hover:bg-blue-200">
                  {d.name}
                </a>
              ) : (
                <span class="text-sm bg-gray-100 text-gray-600 px-3 py-1 rounded-full">{d.name}</span>
              )
            ))}
          </div>
        </section>
      )}

      {term.edamMapping && (
        <section>
          <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-2">EDAM Mapping</h2>
          <div class="bg-green-50 rounded-lg p-4">
            <span class="text-xs font-medium bg-green-200 text-green-800 px-2 py-1 rounded mr-2">
              {term.edamMapping.predicate}
            </span>
            <a href={edamUrl(term.edamMapping.edamId)} target="_blank" rel="noopener" class="text-green-800 hover:underline">
              {term.edamMapping.edamId}
            </a>
            {term.edamMapping.edamLabel && (
              <p class="text-sm text-green-700 mt-2">{term.edamMapping.edamLabel}</p>
            )}
          </div>
        </section>
      )}

      {relatedTerms.length > 0 && (
        <section>
          <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-2">Related FeatureTypes</h2>
          <div class="flex flex-wrap gap-2">
            {relatedTerms.map((t: any) => (
              <a href={`/feature-types/${t.slug}`} class="text-sm bg-gray-100 text-gray-700 px-3 py-1 rounded-full hover:bg-gray-200">
                {t.name}
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </article>
</Layout>
