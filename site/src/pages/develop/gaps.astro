---
import { url } from '../../lib/url';
import Layout from '../../layouts/Layout.astro';
import ModeBanner from '../../components/ModeBanner.astro';
import StateChip from '../../components/StateChip.astro';
import DecisionControl from '../../components/DecisionControl.astro';
import data from '../../data/develop/gaps.json';
import { subject, findingsById } from '../../lib/develop';
import { findingDecided, subjectsDecided } from '../../lib/findings';

const gapData = data as any;
const subsets = Object.keys(gapData.by_subset || {}).sort();
const allTerms = subsets.flatMap((s) => (gapData.by_subset[s]?.terms || []) as any[]);
const href = (sid: string) => url(subject(sid)?.href ?? '/develop');
---

<Layout title="Gap Terms" side="develop" description="Terms with no close match in external ontologies">
  <h1 class="text-3xl font-bold text-gray-900 mb-2">Gap Terms</h1>
  <p class="text-gray-600 mb-6">
    {gapData.gap_terms_count} terms (out of {gapData.total_onga_terms}) have no close match
    in the compared ontologies. These are either genuinely novel to ONGA or may need rework.
  </p>

  <ModeBanner />

  <div class="flex flex-wrap gap-4 mb-6">
    <select id="subset-filter" class="px-3 py-2 border border-gray-300 rounded text-sm">
      <option value="">All subsets ({allTerms.length})</option>
      {subsets.map((s) => (
        <option value={s}>{s.replace(/_/g, ' ')} ({gapData.by_subset[s]?.count || 0})</option>
      ))}
    </select>
    <label class="flex items-center gap-2 text-sm text-gray-600">
      <input type="checkbox" id="hide-decided" />
      Hide decided
    </label>
  </div>

  <div class="space-y-6">
    {subsets.map((subset) => (
      <section class="subset-section" data-subset={subset}>
        <h2 class="text-lg font-semibold text-gray-900 mb-3 capitalize">
          {subset.replace(/_/g, ' ')}
          <span class="text-sm font-normal text-gray-500 ml-2">
            ({gapData.by_subset[subset]?.count || 0})
          </span>
        </h2>
        <div class="bg-white rounded-lg shadow-sm divide-y divide-gray-100">
          {(gapData.by_subset[subset]?.terms || []).map((term: any) => {
            const sid = term.subjects[0];
            const decided = findingDecided(term.id) || subjectsDecided([sid]);
            return (
              <div class="gap-row p-4 hover:bg-gray-50 flex flex-wrap gap-4 items-start justify-between"
                   id={term.id}
                   data-subset={subset}
                   data-finding={term.id}
                   data-decided={decided ? '1' : ''}>
                <div class="flex-1 min-w-[16rem]">
                  <div class="flex items-center gap-2">
                    <a href={href(sid)} class="font-medium text-blue-700 hover:underline">{term.onga_term}</a>
                    <StateChip sid={sid} />
                  </div>
                  <div class="text-xs text-gray-500 mt-1">{term.category} · <span class="font-mono">{term.id}</span></div>
                  <p class="text-sm text-gray-600 mt-1">{term.definition || 'No definition'}</p>
                  <div class="text-xs text-gray-400 mt-1">
                    Best match similarity: <span class="font-mono">{(term.max_similarity || 0).toFixed(3)}</span>
                    {term.best_match && <span> ({term.best_match})</span>}
                  </div>
                </div>
                <div class="w-full md:w-[26rem] shrink-0">
                  <DecisionControl
                    sid={sid}
                    findingId={term.id}
                    suggestedVerdict={findingsById[term.id]?.suggested_verdict}
                  />
                </div>
              </div>
            );
          })}
        </div>
      </section>
    ))}
  </div>

  {allTerms.length === 0 && (
    <div class="bg-white rounded-lg p-8 shadow-sm text-center text-gray-500">
      No gap analysis data available. Run <code>make embeddings-compare</code> to generate reports.
    </div>
  )}

  <script>
    const subsetFilter = document.getElementById('subset-filter') as HTMLSelectElement;
    const hideDecided = document.getElementById('hide-decided') as HTMLInputElement;
    const sections = document.querySelectorAll<HTMLElement>('.subset-section');
    const rows = document.querySelectorAll<HTMLElement>('.gap-row');

    function applyFilters() {
      const subset = subsetFilter.value;
      sections.forEach((sec) => {
        sec.classList.toggle('hidden', !!subset && sec.dataset.subset !== subset);
      });
      rows.forEach((row) => {
        const subsetMatch = !subset || row.dataset.subset === subset;
        const decidedHidden = hideDecided.checked && !!row.dataset.decided;
        row.classList.toggle('hidden', !subsetMatch || decidedHidden);
      });
    }

    subsetFilter.addEventListener('change', applyFilters);
    hideDecided.addEventListener('change', applyFilters);
  </script>
</Layout>
