---
import { url } from '../../lib/url';
import Layout from '../../layouts/Layout.astro';
import ModeBanner from '../../components/ModeBanner.astro';
import StateChip from '../../components/StateChip.astro';
import DecisionControl from '../../components/DecisionControl.astro';
import data from '../../data/develop/merge-candidates.json';
import { subject } from '../../lib/develop';
import { findingDecided, subjectsDecided } from '../../lib/findings';

const pairs = ((data as any).pairs || []) as any[];
const subsets = [...new Set(pairs.flatMap((p: any) => [p.term1_subset, p.term2_subset]))].filter(Boolean).sort();
const href = (sid: string) => url(subject(sid)?.href ?? '/develop');
---

<Layout title="Merge Candidates" side="develop" description="Highly similar ONGA term pairs">
  <h1 class="text-3xl font-bold text-gray-900 mb-2">Merge Candidates</h1>
  <p class="text-gray-600 mb-6">
    {pairs.length} pairs of terms with high embedding similarity that may be duplicates or near-duplicates.
    A decision is recorded on the first term; merging suggests folding it into the second.
  </p>

  <ModeBanner />

  <div class="flex flex-wrap gap-4 mb-6">
    <select id="subset-filter" class="px-3 py-2 border border-gray-300 rounded text-sm">
      <option value="">All subsets</option>
      {subsets.map((s: string) => <option value={s}>{s.replace(/_/g, ' ')}</option>)}
    </select>
    <label class="flex items-center gap-2 text-sm text-gray-600">
      <input type="checkbox" id="cross-category" />
      Cross-category only
    </label>
    <label class="flex items-center gap-2 text-sm text-gray-600">
      <input type="checkbox" id="hide-decided" />
      Hide decided
    </label>
  </div>

  <div class="bg-white rounded-lg shadow-sm overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 text-left">
        <tr>
          <th class="px-4 py-3 font-medium text-gray-700">Term 1</th>
          <th class="px-4 py-3 font-medium text-gray-700">Term 2</th>
          <th class="px-4 py-3 font-medium text-gray-700">Similarity</th>
          <th class="px-4 py-3 font-medium text-gray-700">Subset</th>
          <th class="px-4 py-3 font-medium text-gray-700 w-[26rem]">Decision</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100" id="pairs-table">
        {pairs.map((p: any) => {
          const [a, b] = p.subjects;
          const decided = findingDecided(p.id) || subjectsDecided([a, b]);
          return (
            <tr class="pair-row hover:bg-gray-50 align-top"
                id={p.id}
                data-finding={p.id}
                data-subset1={p.term1_subset}
                data-subset2={p.term2_subset}
                data-cross={String(p.crosses_categories)}
                data-decided={decided ? '1' : ''}>
              <td class="px-4 py-3">
                <a href={href(a)} class="font-medium text-blue-700 hover:underline">{p.term1}</a>
                <div class="text-xs text-gray-500">{p.term1_category} / {p.term1_subset?.replace(/_/g, ' ')}</div>
                <div class="mt-1"><StateChip sid={a} /></div>
              </td>
              <td class="px-4 py-3">
                <a href={href(b)} class="font-medium text-blue-700 hover:underline">{p.term2}</a>
                <div class="text-xs text-gray-500">{p.term2_category} / {p.term2_subset?.replace(/_/g, ' ')}</div>
                <div class="mt-1"><StateChip sid={b} /></div>
              </td>
              <td class="px-4 py-3">
                <span class:list={[
                  'font-mono text-xs px-2 py-1 rounded',
                  p.similarity >= 0.95 ? 'bg-red-100 text-red-800' :
                  p.similarity >= 0.90 ? 'bg-orange-100 text-orange-800' :
                  'bg-yellow-100 text-yellow-800'
                ]}>
                  {p.similarity.toFixed(4)}
                </span>
                {p.machine_recommendation && (
                  <div class="text-xs text-gray-400 mt-1">{p.machine_recommendation}</div>
                )}
                <div class="text-xs text-gray-400 font-mono mt-1">{p.id}</div>
              </td>
              <td class="px-4 py-3 text-xs text-gray-500">
                {p.term1_subset === p.term2_subset ? p.term1_subset?.replace(/_/g, ' ') : `${p.term1_subset} / ${p.term2_subset}`}
              </td>
              <td class="px-4 py-3">
                <DecisionControl
                  sid={a}
                  findingId={p.id}
                  suggestedVerdict="merge"
                  suggestedOperation={{ into: b, mappings: 'move' }}
                />
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  {pairs.length === 0 && (
    <div class="bg-white rounded-lg p-8 shadow-sm text-center text-gray-500 mt-4">
      No merge candidates. Run <code>make embeddings-compare</code> to generate reports.
    </div>
  )}

  <script>
    const subsetFilter = document.getElementById('subset-filter') as HTMLSelectElement;
    const crossCheck = document.getElementById('cross-category') as HTMLInputElement;
    const hideDecided = document.getElementById('hide-decided') as HTMLInputElement;
    const rows = document.querySelectorAll<HTMLElement>('.pair-row');

    function applyFilters() {
      const subset = subsetFilter.value;
      rows.forEach((row) => {
        let show = true;
        if (subset && row.dataset.subset1 !== subset && row.dataset.subset2 !== subset) show = false;
        if (crossCheck.checked && row.dataset.cross !== 'true') show = false;
        if (hideDecided.checked && row.dataset.decided) show = false;
        row.classList.toggle('hidden', !show);
      });
    }

    subsetFilter.addEventListener('change', applyFilters);
    crossCheck.addEventListener('change', applyFilters);
    hideDecided.addEventListener('change', applyFilters);
  </script>
</Layout>
