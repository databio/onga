---
import { url } from '../../lib/url';
import Layout from '../../layouts/Layout.astro';
import ModeBanner from '../../components/ModeBanner.astro';
import StateChip from '../../components/StateChip.astro';
import DecisionControl from '../../components/DecisionControl.astro';
import data from '../../data/develop/mapping-suggestions.json';
import { subject } from '../../lib/develop';
import { findingDecided, hasSssomRow, sssomRows, toCurie } from '../../lib/findings';

// SO rows use the element-type predicate (set/element rule, mappings/policy.yaml);
// EDAM gets closeMatch; anything else relatedMatch. The curator can change it.
const predicateFor = (ontology: string) =>
  ontology === 'so' ? 'onga:has_element_type' : ontology === 'edam' ? 'skos:closeMatch' : 'skos:relatedMatch';

const report = data as any;
// Drop suggestions that already have a positive or negated SSSOM row.
const terms = ((report.terms || []) as any[])
  .map((t) => ({ ...t, suggested_mappings: (t.suggested_mappings || []).filter((m: any) => !hasSssomRow(t.subject, m.term_id)) }))
  .filter((t) => t.suggested_mappings.length > 0);
const isMapped = (t: any) => sssomRows(t.subject).some((r) => r.modifier !== 'Not');
const unmapped = terms.filter((t) => !isMapped(t));
const mapped = terms.filter(isMapped);
const suggestionCount = terms.reduce((n, t) => n + t.suggested_mappings.length, 0);
const href = (sid: string) => url(subject(sid)?.href ?? '/develop');
---

<Layout title="Mapping Suggestions" side="develop" description="Suggested ontology mappings for ONGA terms">
  <h1 class="text-3xl font-bold text-gray-900 mb-2">Mapping Suggestions</h1>
  <p class="text-gray-600 mb-6">
    {suggestionCount} open suggestions on {terms.length} terms.
    {unmapped.length} terms have no mapping yet; {mapped.length} already have one.
    Suggestions that already have an adopted or rejected SSSOM row are hidden.
  </p>

  <ModeBanner />

  <div class="flex flex-wrap gap-4 mb-6">
    <select id="mapping-filter" class="px-3 py-2 border border-gray-300 rounded text-sm">
      <option value="">All terms ({terms.length})</option>
      <option value="unmapped">Unmapped only ({unmapped.length})</option>
      <option value="mapped">Already mapped ({mapped.length})</option>
    </select>
    <input type="search" id="search" placeholder="Search terms..." class="px-3 py-2 border border-gray-300 rounded text-sm" />
    <label class="flex items-center gap-2 text-sm text-gray-600">
      <input type="checkbox" id="hide-decided" />
      Hide decided
    </label>
  </div>

  <div class="space-y-4" id="terms-list">
    {terms.map((term: any) => {
      const rows = sssomRows(term.subject);
      return (
        <div class="mapping-term bg-white rounded-lg shadow-sm p-4"
             data-sid={term.subject}
             data-mapped={isMapped(term) ? 'mapped' : 'unmapped'}
             data-name={term.onga_term.toLowerCase()}>
          <div class="mb-3">
            <div class="flex items-center gap-2">
              <a href={href(term.subject)} class="font-medium text-blue-700 hover:underline">{term.onga_term}</a>
              <StateChip sid={term.subject} />
            </div>
            <div class="text-xs text-gray-500">{term.onga_category} / {term.onga_subset?.replace(/_/g, ' ')}</div>
            <p class="text-sm text-gray-600 mt-1">{term.onga_definition || 'No definition'}</p>
            {rows.length > 0 && (
              <div class="text-xs text-green-700 mt-1">
                Current rows: {rows.map((r: any) => `${r.modifier === 'Not' ? 'NOT ' : ''}${r.predicate} ${r.object}`).join('; ')}
              </div>
            )}
          </div>
          <div class="border-t border-gray-100 pt-3 space-y-3">
            {term.suggested_mappings.map((m: any) => {
              const object = toCurie(m.term_id);
              return (
                <div class="mapping-suggestion flex flex-wrap gap-4 items-start border-b border-gray-50 pb-3 last:border-0"
                     id={m.id}
                     data-finding={m.id}
                     data-decided={findingDecided(m.id) ? '1' : ''}>
                  <div class="flex-1 min-w-[14rem] text-xs">
                    <span class="text-gray-500 uppercase mr-2">{m.ontology}</span>
                    <span class="text-gray-900 text-sm">{m.term_name}</span>
                    <span class="text-gray-400 ml-1">({object})</span>
                    <div class="mt-1">
                      <span class:list={[
                        'font-mono px-1.5 py-0.5 rounded',
                        m.similarity >= 0.7 ? 'bg-green-100 text-green-800' :
                        m.similarity >= 0.5 ? 'bg-yellow-100 text-yellow-800' :
                        'bg-gray-100 text-gray-600'
                      ]}>
                        {m.similarity.toFixed(3)}
                      </span>
                      {m.match_type && <span class="ml-2 text-gray-500">{m.match_type}</span>}
                      <span class="ml-2 text-gray-400 font-mono">{m.id}</span>
                    </div>
                    {m.definition && <p class="text-gray-500 mt-1">{m.definition}</p>}
                  </div>
                  <div class="w-full md:w-[26rem] shrink-0">
                    <DecisionControl
                      sid={term.subject}
                      findingId={m.id}
                      suggestedVerdict="adopt_mapping"
                      suggestedOperation={{ predicate: predicateFor(m.ontology), object, object_label: m.term_name }}
                    />
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      );
    })}
  </div>

  {terms.length === 0 && (
    <div class="bg-white rounded-lg p-8 shadow-sm text-center text-gray-500">
      No open mapping suggestions. Run <code>make embeddings-compare</code> to generate reports.
    </div>
  )}

  <script>
    const mappingFilter = document.getElementById('mapping-filter') as HTMLSelectElement;
    const searchInput = document.getElementById('search') as HTMLInputElement;
    const hideDecided = document.getElementById('hide-decided') as HTMLInputElement;
    const termCards = document.querySelectorAll<HTMLElement>('.mapping-term');

    function applyFilters() {
      const filter = mappingFilter.value;
      const query = searchInput.value.toLowerCase().trim();
      termCards.forEach((card) => {
        let show = true;
        if (filter && card.dataset.mapped !== filter) show = false;
        if (query && !card.dataset.name!.includes(query)) show = false;
        let open = 0;
        card.querySelectorAll<HTMLElement>('.mapping-suggestion').forEach((s) => {
          const hide = hideDecided.checked && !!s.dataset.decided;
          s.classList.toggle('hidden', hide);
          if (!hide) open++;
        });
        if (open === 0) show = false;
        card.classList.toggle('hidden', !show);
      });
    }

    mappingFilter.addEventListener('change', applyFilters);
    searchInput.addEventListener('input', applyFilters);
    hideDecided.addEventListener('change', applyFilters);
  </script>
</Layout>
