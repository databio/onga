---
import Layout from '../../layouts/Layout.astro';
import OpenQuestions from '../../components/OpenQuestions.astro';
import { slotSid, termSid } from '../../lib/browse';
import geometry from '../../data/track-geometry.json';

// Properties are listed in the schema's slot order (src/track_geometry.yaml).
const properties = geometry.properties;
const valueTypes = geometry.valueTypes;
---

<Layout title="Track Geometry" description="Structural properties of a genomic track — the shape of its features">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900 mb-2">Track Geometry</h1>
    <div class="mb-2"><OpenQuestions sid="class:TrackGeometry" /></div>
    <p class="text-amber-600 font-medium">{properties.length} properties</p>
    <p class="text-gray-600 mt-2">
      Geometric or structural properties of the sequence features in a genomic
      annotation file when considered as a one-dimensional genome browser track.
      Describes the <em>structural shape</em> of a track (point vs interval vs
      signal vs graph), following the track type delineations of Gundersen et
      al. 2011.
    </p>
  </div>

  <!-- Search -->
  <div class="bg-white rounded-lg p-4 shadow-sm mb-8">
    <input
      type="search"
      id="search"
      placeholder="Filter geometry properties..."
      class="w-full px-4 py-2 border border-gray-300 rounded focus:ring-2 focus:ring-amber-500"
    />
  </div>

  <!-- Properties -->
  <section>
    <h2 class="text-xl font-semibold text-gray-900 mb-4">Properties</h2>
    <div class="bg-white rounded-lg shadow-sm overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-left text-xs text-gray-500 uppercase tracking-wide border-b border-gray-200">
            <th class="px-4 py-3">Name</th>
            <th class="px-4 py-3">Description</th>
            <th class="px-4 py-3">Required</th>
            <th class="px-4 py-3">Type</th>
          </tr>
        </thead>
        <tbody>
          {properties.map((prop: any) => (
            <tr
              class="term-item border-b border-gray-100 align-top"
              data-name={prop.name.toLowerCase()}
              data-description={prop.description.toLowerCase()}
            >
              <td class="px-4 py-3">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="font-mono whitespace-nowrap">{prop.name}</span>
                  <OpenQuestions sid={slotSid(prop.name)} />
                </div>
              </td>
              <td class="px-4 py-3 text-gray-600">
                {prop.description}
                {prop.rule && (
                  <div class="text-xs text-amber-700 mt-1">⚑ {prop.rule}</div>
                )}
              </td>
              <td class="px-4 py-3 text-gray-600 whitespace-nowrap">{prop.required ? 'yes' : ''}</td>
              <td class="px-4 py-3 font-mono text-gray-500 whitespace-nowrap">{prop.range}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- ValueType value types -->
  <section class="mt-12">
    <h2 class="text-xl font-semibold text-gray-900 mb-2">Value types</h2>
    <p class="text-gray-600 text-sm mb-4">
      The <code class="bg-gray-100 px-1 rounded">value_type</code> and
      <code class="bg-gray-100 px-1 rounded">edge_weight_type</code> properties
      take one of these data types (the <code class="bg-gray-100 px-1 rounded">ValueType</code> enum).
    </p>
    <div class="bg-white rounded-lg shadow-sm overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-left text-xs text-gray-500 uppercase tracking-wide border-b border-gray-200">
            <th class="px-4 py-3">Name</th>
            <th class="px-4 py-3">Description</th>
          </tr>
        </thead>
        <tbody>
          {valueTypes.map((vt: any) => (
            <tr class="border-b border-gray-100 align-top">
              <td class="px-4 py-3">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="font-mono whitespace-nowrap">{vt.name}</span>
                  {vt.ongaId && <OpenQuestions sid={termSid(vt.ongaId)} />}
                </div>
              </td>
              <td class="px-4 py-3 text-gray-600">{vt.description}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <script>
    const searchInput = document.getElementById('search') as HTMLInputElement;
    const items = document.querySelectorAll('.term-item') as NodeListOf<HTMLElement>;

    searchInput?.addEventListener('input', (e) => {
      const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
      items.forEach(item => {
        const name = item.dataset.name || '';
        const desc = item.dataset.description || '';
        const matches = !query || name.includes(query) || desc.includes(query);
        item.classList.toggle('hidden', !matches);
      });
    });
  </script>
</Layout>
