---
// Collapsible list of the workbench review prompts that apply to a subject.
import { promptsFor } from '../lib/develop';

interface Props { sid?: string }
const { sid } = Astro.props;
const list = sid ? promptsFor(sid) : [];
---

{list.length > 0 && (
  <details class="review-prompts bg-violet-50 border border-violet-200 rounded-lg p-4 mb-8 text-sm">
    <summary class="cursor-pointer font-semibold text-violet-900">
      Review prompts ({list.length})
      <span class="ml-2 text-[10px] uppercase tracking-wide bg-violet-200 text-violet-900 px-1.5 py-0.5 rounded">workbench</span>
    </summary>
    <ul class="mt-3 space-y-3">
      {list.map((p) => (
        <li>
          <p class="font-medium text-gray-900">{p.title}</p>
          <p class="text-gray-700 mt-1">{p.text}</p>
          <p class="text-xs text-gray-500 mt-1">{p.source}</p>
        </li>
      ))}
    </ul>
  </details>
)}
