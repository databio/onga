---
// One queue item on a review-type page (pages/develop/queue/[type].astro).
//
// Shows the subject in plain terms (name, where it lives, its definition, why it
// is here) and the type's ready-made answers as buttons. In live mode a button
// saves its decision straight away through the curation daemon, using the row's
// note as the rationale when one is written, else the answer's default. Anything
// the buttons don't cover is one link away on the subject's own page.
// Read-only on the published site, like every workbench control.
import { url } from '../lib/url';
import type { Action, Item } from '../lib/review-types';

interface Props { item: Item }
const { item } = Astro.props;

const TONE: Record<string, string> = {
  primary: 'bg-blue-600 text-white hover:bg-blue-700',
  neutral: 'bg-white text-gray-800 border border-gray-300 hover:bg-gray-50',
  danger: 'bg-white text-red-700 border border-red-300 hover:bg-red-50',
};
const btn = (a: Action) => ({
  class: `ri-action px-3 py-1 rounded text-sm disabled:opacity-40 disabled:cursor-not-allowed ${TONE[a.tone ?? 'neutral']}`,
  'data-action': JSON.stringify(a),
});
---

<li
  class="review-item bg-white rounded-lg shadow-sm p-4"
  data-sid={item.sid}
  data-hash={item.hash}
  data-container={item.container ?? ''}
  data-findings={item.findings.join(' ')}
>
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <div class="min-w-0">
      <a href={url(item.href)} class="font-semibold text-gray-900 hover:text-blue-700 hover:underline">{item.title}</a>
      <span class="ml-2 text-xs text-gray-500">
        {item.kind}{item.containerLabel && <> in <span class="font-medium">{item.containerLabel}</span></>}
      </span>
      {item.browse && <a href={url(item.browse)} class="ml-2 text-xs text-blue-600 hover:underline">view in schema</a>}
    </div>
    <span class="ri-done hidden text-xs font-medium text-emerald-700"></span>
  </div>

  {item.description && !item.editor?.field.startsWith('desc') && (
    <p class="mt-1 text-sm text-gray-600 whitespace-pre-line">{item.description}</p>
  )}

  {item.reasons.length > 0 && (
    <ul class="mt-2 text-sm text-amber-800 list-disc pl-5">
      {item.reasons.map((r) => <li>{r}</li>)}
    </ul>
  )}

  <div class="ri-body">
    {item.choices.map((c) => (
      <div class="mt-3 flex flex-wrap items-center justify-between gap-2 border-t border-gray-100 pt-3">
        <div class="min-w-0 text-sm">
          <div class="text-gray-900">{c.text}</div>
          {c.detail && <div class="text-xs text-gray-500 mt-0.5 line-clamp-2" title={c.detail}>{c.detail}</div>}
        </div>
        <div class="flex flex-wrap gap-2">
          {c.actions.map((a) => <button type="button" disabled {...btn(a)}>{a.label}</button>)}
        </div>
      </div>
    ))}

    {item.editor && (
      <textarea
        class="ri-editor mt-3 w-full px-2 py-1 border border-gray-300 rounded text-sm"
        rows={item.editor.field === 'description' ? 3 : 2}
        placeholder={item.editor.placeholder}
        data-field={item.editor.field}
      >{item.editor.value}</textarea>
    )}

    <div class="mt-3 flex flex-wrap items-center gap-2">
      {item.actions.map((a) => <button type="button" disabled {...btn(a)}>{a.label}</button>)}
      <input
        type="text"
        class="ri-note grow min-w-[12rem] px-2 py-1 border border-gray-200 rounded text-sm"
        placeholder="Note (optional): why? Replaces the default reason."
      />
    </div>
    <p class="ri-msg mt-1 text-xs text-gray-500"></p>

    <a href={url(item.href)} class="mt-1 inline-block text-xs text-gray-500 hover:text-blue-700 hover:underline">
      Something else (rename, merge, move…) →
    </a>
  </div>
</li>

<script>
  import { probe, getDecisions, saveDecision, withdrawDecision, CurationError, CURATION_API, DECISION_EVENT, type Decision } from '../lib/curation';
  import decisionsDoc from '../data/develop/decisions.json';

  type Action = {
    label: string; verdict: string; operation?: Record<string, unknown>; rationale: string;
    evidence?: string; also?: string[]; input?: 'description' | 'examples'; confirm?: string;
  };
  // Decisions numbered at or above this were made after the site data was built.
  const BUILD_NEXT = Number((decisionsDoc as any).next_id ?? 0);
  const num = (id: string) => Number(id.replace(/\D/g, ''));

  function setDone(li: HTMLElement, d: Decision | null) {
    const done = li.querySelector<HTMLElement>('.ri-done')!;
    li.dataset.done = d ? d.id : '';
    li.classList.toggle('opacity-60', !!d);
    li.querySelector('.ri-body')!.classList.toggle('hidden', !!d);
    done.classList.toggle('hidden', !d);
    done.replaceChildren();
    li.dispatchEvent(new CustomEvent('review:changed', { bubbles: true }));
    if (!d) return;
    done.append(`Saved: ${d.verdict.replace(/_/g, ' ')} (${d.id}) `);
    if (d.status === 'pending') {
      const undo = document.createElement('button');
      undo.type = 'button';
      undo.className = 'ml-1 underline text-gray-600 hover:text-gray-900';
      undo.textContent = 'Undo';
      undo.addEventListener('click', async () => {
        await withdrawDecision(d.id);
        setDone(li, null);
      });
      done.append(undo);
    }
  }

  function setup(li: HTMLElement) {
    const msg = li.querySelector<HTMLElement>('.ri-msg')!;
    const note = li.querySelector<HTMLInputElement>('.ri-note')!;
    const editor = li.querySelector<HTMLTextAreaElement>('.ri-editor');
    const buttons = [...li.querySelectorAll<HTMLButtonElement>('.ri-action')];

    async function save(a: Action, ask = true): Promise<boolean> {
      if (ask && a.confirm && !confirm(a.confirm)) return false;
      const operation: Record<string, unknown> = { ...(a.operation || {}) };
      if (a.input === 'description') {
        const text = editor?.value.trim() ?? '';
        if (!text) { msg.textContent = 'Write the definition first.'; return false; }
        operation.description = text;
      }
      if (a.input === 'examples') {
        const values = (editor?.value ?? '').split('\n').map((s) => s.trim()).filter(Boolean);
        if (!values.length) { msg.textContent = 'Add at least one example (one per line).'; return false; }
        operation.examples = values.map((value) => ({ value }));
      }
      const also = a.also ?? [];
      const hashes: Record<string, string> = { [li.dataset.sid!]: li.dataset.hash! };
      if (also.length) {
        const all = await fetch(`${CURATION_API}/api/subjects`).then((r) => r.json()).then((d) => d.subjects);
        for (const s of also) if (all[s]) hashes[s] = all[s].hash;
      }
      buttons.forEach((b) => (b.disabled = true));
      msg.textContent = 'Saving…';
      try {
        const d = await saveDecision({
          subject: li.dataset.sid!,
          verdict: a.verdict,
          operation: Object.keys(operation).length ? { op: a.verdict, ...operation } : null,
          rationale: note.value.trim() || a.rationale,
          also_affects: also,
          evidence: a.evidence ? [{ kind: 'finding', id: a.evidence }] : [],
          subject_hashes: hashes,
          supersedes: null,
        });
        msg.textContent = '';
        setDone(li, d);
        return true;
      } catch (e) {
        msg.textContent = e instanceof CurationError && e.status === 409
          ? `Conflict: ${e.message}. Reload the page.`
          : `Not saved: ${(e as Error).message}`;
        return false;
      } finally {
        buttons.forEach((b) => (b.disabled = false));
      }
    }

    // Used by the page's "approve whole group" button, which saves rows one at a time.
    (li as any).reviewSave = (verdict: string) => {
      const b = buttons.find((x) => JSON.parse(x.dataset.action!).verdict === verdict);
      return b ? save(JSON.parse(b.dataset.action!), false) : Promise.resolve(false);
    };
    for (const b of buttons) {
      b.disabled = false;
      b.addEventListener('click', () => save(JSON.parse(b.dataset.action!)));
    }
  }

  probe().then(async (health) => {
    if (!health) return;
    const items = [...document.querySelectorAll<HTMLElement>('.review-item')];
    items.forEach(setup);
    // A decision answers this row when it cites one of the row's findings, or
    // cites none (a blanket judgment), matching scripts/curation_status.py.
    const answers = (li: HTMLElement, d: Decision) => {
      if (d.subject !== li.dataset.sid && !d.also_affects?.includes(li.dataset.sid!)) return false;
      const cited = (d.evidence || []).map((e) => e.id).filter(Boolean);
      const mine = (li.dataset.findings || '').split(' ').filter(Boolean);
      return cited.length === 0 || cited.some((id) => mine.includes(id!));
    };
    // Rows answered since the build (this session, or before a regen) show as done.
    const store = await getDecisions().catch(() => null);
    for (const d of store?.decisions ?? []) {
      if (d.status === 'withdrawn' || num(d.id) < BUILD_NEXT) continue;
      for (const li of items) if (answers(li, d)) setDone(li, d);
    }
    document.addEventListener(DECISION_EVENT, (ev) => {
      const d = (ev as CustomEvent<Decision>).detail;
      for (const li of items) {
        if (d.status === 'pending' && li.dataset.done !== d.id && answers(li, d)) setDone(li, d);
      }
    });
  });
</script>
